<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oryxos</groupId>
        <artifactId>oryxos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>oryxos-tool</artifactId>
    <name>OryxOS :: Tool</name>
    <description>核心能力四：内置 Tool（FileTools / ShellTools / HttpTools / NotifyTools）、McpClientService、McpToolAdapter、ToolRegistry、Sandbox 接口 + WhitelistSandbox、NotifyChannelAdapter + WebhookNotifyAdapter</description>

    <dependencies>
        <!-- Internal -->
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>

        <!-- Internal：NotifyChannelRegistry 消费 NotifyChannelRepository（004-notify；能力层依赖 storage，CLAUDE.md 依赖方向） -->
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>

        <!-- Spring AI Model（@Tool 注解 schema 生成；1.1.x 起 spring-ai-core 拆分为 model/commons/client-chat） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- spring-web：RestClient（004-notify WebhookNotifyAdapter；版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- 测试栈（004-notify：模块首个测试；JUnit 5 + Mockito + AssertJ，oryxos-core 同款先例） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockWebServer 假 webhook（004-notify 单测层；Boot BOM 不管理 okhttp3，显式版本与本地 okhttp 4.12.0 对齐） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>

        <!-- 门禁配套注解（provided，编译期）：SpotBugs 抑制注解（004-notify 补列，001-provider 同款先例） -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>4.10.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- MCP Client（005-tool 方式二：连接外部 MCP server；版本随 spring-ai-bom 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- @Tool 扫描自动配置（005-tool 方式三：MethodToolCallbackProvider bean 来源；版本随 spring-ai-bom 管理，
             2026-09-05 用户拍板补列——原降级状态仅手动注册可走） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-autoconfigure-model-tool</artifactId>
        </dependency>
    </dependencies>
</project>
